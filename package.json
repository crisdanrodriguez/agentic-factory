{
  "name": "agentic-factory",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Local configuration and contract bootstrap for Agentic Factory",
  "engines": { "node": "24.22.0", "npm": "11.9.0" },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && node --test --test-reporter=spec .test-build/tests/*.test.js",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
